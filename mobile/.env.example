# Copy to .env and fill in your Supabase project's values.
# Both must be prefixed with EXPO_PUBLIC_ to be readable client-side —
# the anon key is safe to ship; access is enforced by the RLS policies
# in ../schema.sql.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
